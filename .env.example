# Copy to .env (never commit .env). All values below are placeholders.
NODE_ENV=production     # use production when deployed behind HTTPS
PORT=8090                 # website port (your Barid-IN app keeps 8080)
# Public URL of THIS website, no trailing slash (used for canonical/OG/sitemap)
SITE_URL=https://Barid-IN_website.onrender.com
# REQUIRED in production: long random string used to sign demo-session cookies
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=ff3b0cb7a54b06ced7af68632b82399835348a7bb1dfe8058a43c755c09e0be7
# Bearer token that protects GET /api/admin/leads (leave empty to disable the endpoint)
ADMIN_TOKEN=63f17f63106b47bf043a4edf1214a8ff3cd5d6915f601669
# Hours a registered visitor keeps demo access
DEMO_SESSION_HOURS=4
# Set to true when running behind a reverse proxy / platform load balancer (Render, Nginx, Caddy...)
TRUST_PROXY=true
# Where "Sign In" goes: the deployed Barid-IN application (optional until it is deployed)
APP_URL=
# After a visitor registers they are sent here. Local: your running Barid-IN app. Deployed: your demo copy's public URL.
DEMO_APP_URL=https://hawmess-frontend.onrender.com
# Shown in the Contact section (optional)
CONTACT_EMAIL=gurussad@aiyyaartechsol.com
# Folders for private videos and saved data. On a host, point DATA_DIR at a persistent disk/volume.
MEDIA_DIR=./media
DATA_DIR=./data
